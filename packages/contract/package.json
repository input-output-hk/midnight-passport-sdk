{
  "name": "@input-output-hk/mn-passport-contract",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bindings/acc-s3r1.1": {
      "types": "./generated/acc-s3r1.1/index.d.ts",
      "default": "./generated/acc-s3r1.1/index.js"
    },
    "./shielded-withdrawal": {
      "types": "./dist/shielded-withdrawal.d.ts",
      "default": "./dist/shielded-withdrawal.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "default": "./dist/capabilities.js"
    },
    "./capabilities.json": "./resources/acc-s3r1.1.capabilities.json"
  },
  "bin": {
    "mn-passport-restore-keys": "bin/restore-acc-keys.mjs",
    "mn-passport-export-compact": "bin/export-acc-compact.mjs"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "bin",
    "resources",
    "generated",
    "acc-binding-v2.generated.json"
  ],
  "peerDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.20.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/input-output-hk/midnight-passport-sdk"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
