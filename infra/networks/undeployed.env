# The local Midnight stack the Passport prototype runs on (docker compose, infra/localnet). The
# default of scripts/prototype-up.sh (MIDNIGHT_STACK=undeployed). The ports match
# infra/localnet/ports.env; a test keeps the two in step, so change both together.
MN_NETWORK_ID=undeployed
MN_NODE_URL=http://localhost:19944
MN_INDEXER_URL=http://localhost:18088/api/v4/graphql
MN_INDEXER_WS_URL=ws://localhost:18088/api/v4/graphql/ws
MN_PROOF_SERVER_URL=http://127.0.0.1:16300
