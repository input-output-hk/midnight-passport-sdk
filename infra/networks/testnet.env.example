# Example of a hosted Midnight stack for the Passport prototype. Copy to infra/networks/testnet.env
# and fill in the TODOs; then start with `MIDNIGHT_STACK=testnet pnpm prototype:up`. The script
# starts no local localnet for a stack other than `undeployed`.
#
# TODO (LW-15635): testnet is not ready to run on these. It needs hosted artefacts (the dApp and
# the service both read the compiled account contract), a reachable proof server and a real
# sponsor: set PASSPORT_SPONSOR_SEED to a funded wallet seed (the service refuses to start on
# another network without it, and never reads it from this file). These URLs are placeholders,
# not real hosts.
MN_NETWORK_ID=testnet # TODO: the real network id (lower-case letters, digits, hyphens)
MN_NODE_URL=https://node.testnet.example.invalid # TODO
MN_INDEXER_URL=https://indexer.testnet.example.invalid/api/v4/graphql # TODO
MN_INDEXER_WS_URL=wss://indexer.testnet.example.invalid/api/v4/graphql/ws # TODO
MN_PROOF_SERVER_URL=https://proof.testnet.example.invalid # TODO
