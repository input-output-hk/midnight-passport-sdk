# Host ports of the Passport localnet. They differ from the Midnight defaults (9944/8088/6300) so
# the stack runs beside another localnet on the same machine. Inside the compose network the
# containers keep their standard ports. Sourced by scripts/prototype-up.sh, experiments/acc-0.35/run.sh
# and patch-endpoints.sh; the service reads the same variables (with these defaults).
MN_NODE_PORT=19944
MN_INDEXER_PORT=18088
MN_PROOF_PORT=16300
