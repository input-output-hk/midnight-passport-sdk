# Copy to .midnight-indexer.env in this directory for a new Ledger 9 project.
# Use independent random values; APP__INFRA__SECRET must be hex.
# Reuse the existing private values when reopening a project with retained volumes.
APP__INFRA__STORAGE__PASSWORD=
APP__INFRA__PUB_SUB__PASSWORD=
APP__INFRA__LEDGER_STATE_STORAGE__PASSWORD=
APP__INFRA__SECRET=
